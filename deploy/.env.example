# Parámetros de la infraestructura. Copiar a `.env` en esta misma carpeta.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Compose lee este archivo solo para interpolar los ${...} de
# docker-compose.prod.yml. **Su contenido no entra en ningún contenedor**, y por
# eso es acá donde vive la contraseña del superusuario de Postgres: la API no
# tiene por qué poder leerla (D-017).
#
# Las variables de la aplicación van en `.env.app`, que es el archivo que sí
# lee el proceso Node.

# Dominio que resuelve a la IP de la VM. Caddy pide el certificado para este
# nombre, así que tiene que estar apuntado ANTES de levantar los servicios.
DOMINIO=api.terravid.duckdns.org

# Dirección a la que Let's Encrypt avisa si un certificado está por vencer sin
# renovarse. Que sea una que alguien lea.
EMAIL_ACME=equipo@ejemplo.com

# Imagen publicada en Artifact Registry (Apéndice A.7). Conviene apuntar a un
# tag inmutable —el SHA corto del commit— y no a `latest`: así se sabe qué está
# corriendo, y volver atrás es cambiar esta línea.
API_IMAGE=us-central1-docker.pkg.dev/terravid-prod/terravid/api:abc1234

# Contraseña del superusuario `postgres` del contenedor. Es la credencial de
# DDL: se usa para las migraciones por el túnel SSH y NO es la que usa la API.
POSTGRES_ROOT_PASSWORD=
