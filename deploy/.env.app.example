# Variables de la aplicación. Copiar a `.env.app` en esta misma carpeta.
#
#   cp .env.app.example .env.app
#   chmod 600 .env.app
#
# Es el único archivo que lee el proceso Node. Los parámetros de la
# infraestructura —dominio, imagen, contraseña de superusuario— van en `.env`.
#
# NODE_ENV, DB_HOST, DB_PORT y TRUST_PROXY_HOPS los fija
# docker-compose.prod.yml: no van acá.

DB_DATABASE=terravid

# El rol acotado que crea `npm run db:rol-app` (D-017). La API se conecta con
# este, que no puede hacer DDL: si hay una inyección SQL en algún endpoint, no
# tiene permiso para DROP TABLE.
DB_USERNAME=terravid_app
DB_PASSWORD=

# El esquema lo gobiernan las migraciones. En producción la variable se ignora,
# queda explícita para que no haya dudas.
DB_SYNCHRONIZE=false

# Generar valores nuevos, no reusar los del .env.example del repositorio:
#   openssl rand -base64 48
JWT_SECRET=
# La duración de las sesiones se configura por empresa desde la aplicación
# (D-023): JWT_EXPIRES_IN y JWT_REFRESH_* ya no se usan.

# Mínimo 12 (HU-01).
BCRYPT_SALT_ROUNDS=12

# La clave con la que se autentican los nodos ESP32 en el header X-Api-Key.
# Sin ella configurada, el endpoint de ingesta queda cerrado.
#   openssl rand -hex 32
IOT_API_KEY=

# Ingesta MQTT (D-026). Solo con el broker desplegado (COMPOSE_PROFILES=mqtt
# en .env). MQTT_USUARIO y MQTT_PASSWORD tienen que coincidir con
# MQTT_ADMIN_USUARIO y MQTT_ADMIN_PASSWORD del .env de la infraestructura.
# MQTT_URL=mqtt://mqtt:1883
# MQTT_USUARIO=terravid-api
# MQTT_PASSWORD=
# MQTT_URL_PUBLICA=mqtts://terravid-api.duckdns.org:8883

# Correo saliente (HU-03, HU-22, HU-36). `log` escribe el mail en consola; para
# mandarlos de verdad, `smtp` con las credenciales de abajo.
MAIL_TRANSPORT=log
MAIL_FROM=TerraVid <no-reply@terravid.com.ar>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Push a móviles vía FCM (HU-35). `fcm` exige las tres credenciales del service
# account de Firebase. La clave privada va en UNA línea y con los saltos
# escapados como texto (\n), igual que en desarrollo: el código hace el replace.
PUSH_TRANSPORT=log
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# URL del cliente web. Alimenta los enlaces de los correos de recuperación de
# contraseña y de alertas: un valor viejo genera links rotos.
APP_URL=https://terravid.com.ar
CORS_ORIGIN=https://terravid.com.ar

# Ventana de deduplicación de alertas IoT en minutos (HU-22).
ALERTAS_VENTANA_DEDUP_MINUTOS=60

# Retención de datos que purgan los cron nocturnos.
NOTIFICACIONES_RETENCION_DIAS=30
LECTURAS_RETENCION_DIAS=30
