NODE_ENV=development
PORT=3000

# PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=terravid

# El esquema lo gobiernan las migraciones de `src/database/migrations`:
#   npm run migration:run
# Ponerlo en true solo para prototipar; en producción la variable se ignora.
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt (mínimo 12 — HU-01)
BCRYPT_SALT_ROUNDS=12

# Ingesta de telemetría IoT (HU-19).
# Los nodos ESP32 se autentican con esta clave en el header X-Api-Key.
# Sin ella configurada, el endpoint de ingesta queda cerrado.
IOT_API_KEY=change-this-iot-api-key-in-production

# Correo saliente (HU-03, HU-22, HU-36).
# MAIL_TRANSPORT=log escribe el mail en consola en vez de enviarlo (desarrollo).
# MAIL_TRANSPORT=smtp usa las credenciales de abajo.
MAIL_TRANSPORT=log
MAIL_FROM=TerraVid <no-reply@terravid.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Push a dispositivos móviles vía Firebase Cloud Messaging (HU-35).
# PUSH_TRANSPORT=log escribe el envío en consola en vez de mandarlo (desarrollo).
# PUSH_TRANSPORT=fcm exige las tres credenciales de abajo, que salen del service
# account del proyecto de Firebase (Configuración → Cuentas de servicio).
# Sin ellas el push queda deshabilitado y solo se registra un warning.
PUSH_TRANSPORT=log
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# En una sola línea y con los saltos escapados: "-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# URL del cliente web: se usa para armar los enlaces de los correos
# (recuperación de contraseña, bienvenida, alertas).
APP_URL=http://localhost:5173

# Ventana de deduplicación de alertas IoT en minutos (HU-22).
ALERTAS_VENTANA_DEDUP_MINUTOS=60

# Retención de datos que purgan los cron nocturnos.
NOTIFICACIONES_RETENCION_DIAS=30
LECTURAS_RETENCION_DIAS=30

# Proxies de confianza delante de la app. Determina de dónde sale `req.ip`,
# que alimenta el log de auditoría y el rate limiting.
TRUST_PROXY_HOPS=1

# CORS
CORS_ORIGIN=http://localhost:5173
