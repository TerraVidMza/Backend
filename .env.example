NODE_ENV=development
PORT=3000

# PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=terravid

# Rol con el que se conecta la APLICACIÓN. Solo lee y escribe filas: no puede
# crear ni borrar tablas, ni modificar el log de auditoría (D-017).
# En desarrollo alcanza con `postgres`; en producción NO — ver el README.
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Rol con el que se corren las MIGRACIONES, que sí hace DDL. Si se dejan vacías
# se usan las de arriba, que es lo cómodo en desarrollo.
# En producción tienen que ser distintas: si la aplicación se conectara con el
# rol que puede hacer DDL, una inyección SQL en cualquier endpoint podría
# ejecutar DROP TABLE.
#   npm run db:rol-app                  crea el rol acotado
#   npm run db:verificar-privilegios    comprueba que quedó bien
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=

# `npm run db:rol-app` --el comando que crea el rol acotado de arriba-- lee dos
# variables más, y ninguna de las dos va en este archivo:
#
#   DB_APP_PASSWORD   obligatoria, sin valor por defecto. Es la contraseña que
#                     se le pone al rol nuevo, y se pasa en línea para ese único
#                     comando:
#                       DB_APP_PASSWORD='<larga y generada>' npm run db:rol-app
#                     Deliberadamente NO figura acá: dejarla en el `.env` la
#                     convierte en un secreto de larga vida guardado en un
#                     archivo para usarse una sola vez. Después de correr el
#                     comando, va a DB_PASSWORD del entorno de la aplicación.
#
#   DB_APP_USERNAME   opcional, por defecto `terravid_app`. Solo hace falta si
#                     el rol tiene que llamarse distinto.

# El esquema lo gobiernan las migraciones de `src/database/migrations`:
#   npm run migration:run
# Ponerlo en true solo para prototipar; en producción la variable se ignora.
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=change-this-secret-in-production
# La duración del access token (5-60 min, 15 por defecto) y del refresh token
# (1-30 días, 7 por defecto) se configuran por empresa en /configuracion
# (D-023). El refresh token es opaco: no necesita un secreto propio.

# Bcrypt (mínimo 12 — HU-01)
BCRYPT_SALT_ROUNDS=12

# Ingesta de telemetría IoT (HU-19).
# Los nodos ESP32 se autentican con esta clave en el header X-Api-Key.
# Sin ella configurada, el endpoint de ingesta queda cerrado.
IOT_API_KEY=change-this-iot-api-key-in-production

# Correo saliente (HU-03, HU-22, HU-36).
# MAIL_TRANSPORT=log escribe el mail en consola en vez de enviarlo (desarrollo).
# MAIL_TRANSPORT=smtp usa las credenciales de abajo.
MAIL_TRANSPORT=log
MAIL_FROM=TerraVid <no-reply@terravid.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Push a dispositivos móviles vía Firebase Cloud Messaging (HU-35).
# PUSH_TRANSPORT=log escribe el envío en consola en vez de mandarlo (desarrollo).
# PUSH_TRANSPORT=fcm exige las tres credenciales de abajo, que salen del service
# account del proyecto de Firebase (Configuración → Cuentas de servicio).
# Sin ellas el push queda deshabilitado y solo se registra un warning.
PUSH_TRANSPORT=log
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# En una sola línea y con los saltos escapados: "-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# URL del cliente web: se usa para armar los enlaces de los correos
# (recuperación de contraseña, bienvenida, alertas).
APP_URL=http://localhost:5173

# Ventana de deduplicación de alertas IoT en minutos (HU-22).
ALERTAS_VENTANA_DEDUP_MINUTOS=60

# Retención de datos que purgan los cron nocturnos.
NOTIFICACIONES_RETENCION_DIAS=30
LECTURAS_RETENCION_DIAS=30

# Proxies de confianza delante de la app. Determina de dónde sale `req.ip`,
# que alimenta el log de auditoría y el rate limiting.
TRUST_PROXY_HOPS=1

# CORS
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Documentación OpenAPI
# ---------------------------------------------------------------------------
# La UI (/api/docs) y el JSON (/api/docs-json) quedan encendidos fuera de
# producción y apagados en producción. El documento describe cada ruta, cada
# campo y qué rol puede usarla —el perímetro de ataque completo—, así que
# publicarlo junto a la API es una decisión, no un default.
#
# Para generar clientes no hace falta encenderla: `npm run openapi:generar`
# escribe el contrato a openapi.json sin levantar el servidor.
# OPENAPI_ENABLED=true

# ---------------------------------------------------------------------------
# Primer Propietario (seed)
# ---------------------------------------------------------------------------
# Fuera de producción el seed crea propietario@terravid.demo con una contraseña
# fija publicada en el README, y estas dos variables no hacen falta.
#
# Con NODE_ENV=production el seed NO ARRANCA sin SEED_PROPIETARIO_PASSWORD: es
# la única cuenta que puede crear las demás, así que una contraseña conocida ahí
# es la llave del sistema. El usuario entra obligado a cambiarla.
#
# Para rotar la contraseña de una cuenta ya creada: npm run db:rotar-password
# SEED_PROPIETARIO_EMAIL=duenio@tuempresa.com
# SEED_PROPIETARIO_PASSWORD=
