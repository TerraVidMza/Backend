{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*.e2e-spec.ts$",
  "transform": {
    "^.+.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "src/**/*.service.ts"
  ],
  "coverageDirectory": "coverage-e2e",
  "coverageThreshold": {
    "src/modules/auth/auth.service.ts": {
      "statements": 95,
      "branches": 75,
      "functions": 100,
      "lines": 95
    },
    "src/modules/remitos/remitos.service.ts": {
      "statements": 80,
      "branches": 68,
      "functions": 85,
      "lines": 80
    },
    "src/modules/pesaje-vendimia/pesaje-vendimia.service.ts": {
      "statements": 55,
      "branches": 58,
      "functions": 25,
      "lines": 54
    }
  }
}
