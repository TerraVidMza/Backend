{
  "name": "terravid-backend",
  "version": "0.0.1",
  "description": "API REST de TerraVid: ERP agricola de trazabilidad desde la plantacion hasta la vendimia (NestJS + TypeORM + PostgreSQL/PostGIS).",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:smoke": "node test/smoke.mjs",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed.ts",
    "db:rol-app": "ts-node -r tsconfig-paths/register src/database/roles/crear-rol-aplicacion.ts",
    "db:verificar-privilegios": "ts-node -r tsconfig-paths/register src/database/roles/verificar-privilegios.ts",
    "push:diagnostico": "ts-node -r tsconfig-paths/register src/common/push/diagnostico-push.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "typeorm:dist": "node node_modules/typeorm/cli.js -d dist/config/data-source.js",
    "migration:run:dist": "npm run typeorm:dist -- migration:run",
    "migration:show:dist": "npm run typeorm:dist -- migration:show",
    "db:rol-app:dist": "node dist/database/roles/crear-rol-aplicacion.js",
    "db:verificar-privilegios:dist": "node dist/database/roles/verificar-privilegios.js",
    "openapi:generar": "npm run build && node dist/config/generar-openapi.js",
    "prepare": "husky || exit 0",
    "test:cov:e2e": "jest --config ./test/jest-e2e.json --coverage",
    "db:rotar-password": "ts-node -r tsconfig-paths/register src/database/scripts/rotar-password.ts",
    "db:rotar-password:dist": "node dist/database/scripts/rotar-password.js",
    "test:cov:total": "jest --config ./jest.cobertura.config.js --coverage --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.6",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "mqtt": "^5.16.0",
    "nodemailer": "^10.0.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "reflect-metadata"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "src/config/validar-entorno.ts": {
        "statements": 95,
        "branches": 95,
        "functions": 100,
        "lines": 95
      },
      "src/common/tenant/alcance-empresa.service.ts": {
        "statements": 80,
        "branches": 75,
        "functions": 70,
        "lines": 80
      },
      "src/modules/registro-labor/registro-labor.service.ts": {
        "statements": 55,
        "branches": 40,
        "functions": 50,
        "lines": 55
      },
      "src/modules/umbral-sensor/umbral-sensor.service.ts": {
        "statements": 70,
        "branches": 55,
        "functions": 60,
        "lines": 70
      }
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      ".module.ts$",
      "/database/",
      "/dto/",
      ".entity.ts$",
      "main.ts"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  }
}
