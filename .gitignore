# compiled output
/dist
/node_modules

# logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# env
# El patrón cubre .env.produccion y .env.desarrollo, que son los nombres que
# manda crear docs/DESPLIEGUE.md: con solo `.env` quedaban rastreables, o sea
# a un `git add .` de publicar los secretos de producción.
.env
.env.*
!.env.example
!.env.*.example

# OS
.DS_Store

# tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
*.launch
.settings/

# herramientas locales
/.claude

# credenciales
# El service account de Firebase da acceso al proyecto entero y se descarga como
# JSON: que no pueda commitearse por accidente si queda en la carpeta.
firebase-adminsdk*.json
*-firebase-adminsdk-*.json
service-account*.json

# temp
tmp/

# Contrato generado: se regenera con `npm run openapi:generar`.
openapi.json

# Cobertura de los tests de integracion. Sin ancla inicial, a diferencia de
# `/coverage`: una configuracion de Jest mal apuntada deja el reporte colgando
# de otro directorio, y asi no termina versionado por accidente.
coverage-e2e/
coverage/
