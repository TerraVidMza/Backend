# Estos archivos se ejecutan dentro de contenedores Linux o en la VM. Con
# terminaciones CRLF —lo que hace Git en Windows por defecto— el shebang de un
# script falla con "bad interpreter: /usr/bin/env bash^M", y el mensaje no da
# ninguna pista de que el problema son los saltos de línea.
*.sh            text eol=lf
Dockerfile      text eol=lf
deploy/Caddyfile text eol=lf
deploy/*.yml    text eol=lf
# Mosquitto lee su configuración dentro de un contenedor Linux (D-026).
deploy/mosquitto/* text eol=lf

# Las unidades de systemd son peores todavía: con CRLF, el retorno de carro
# queda dentro del valor de `ExecStart` y systemd informa que no encuentra el
# archivo, aunque la ruta se vea bien.
deploy/systemd/* text eol=lf

# Los `run:` de un workflow son scripts de shell que corren en Linux.
.github/workflows/*.yml text eol=lf
